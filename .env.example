# ─────────────────────────────────────────────────────────────
#  Association Al Nissa — variables d'environnement
#  Copiez ce fichier en « .env » et adaptez les valeurs.
# ─────────────────────────────────────────────────────────────

# Base de données.
#  • En local / auto-hébergement : SQLite (aucune config, fonctionne tout de suite)
#  • En production sur Vercel : voir DEPLOYMENT.md pour passer à PostgreSQL
DATABASE_URL="file:./dev.db"

# Secret de session (chiffre le cookie d'admin).
#  IMPORTANT : mettez une longue chaîne aléatoire (>= 32 caractères) en production.
#  Générez-en une avec :  openssl rand -base64 48
SESSION_SECRET="changez-moi-avec-une-longue-chaine-aleatoire-de-32-caracteres-minimum"

# Identifiants du compte administrateur créé au premier « seed ».
#  Changez le mot de passe dès la première connexion depuis l'espace admin.
ADMIN_EMAIL="associationalnissa@gmail.com"
ADMIN_PASSWORD="AlNissa2026!"

# URL publique du site (utilisée pour les métadonnées / partage).
NEXT_PUBLIC_SITE_URL="https://www.association-alnissa.fr"
